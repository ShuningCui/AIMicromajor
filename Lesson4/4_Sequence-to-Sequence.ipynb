    "def sequence_pred(model, X, directions=None, n_rows=2, n_cols=5):\n",
    "    fig, axs = plt.subplots(n_rows, n_cols, figsize=(4 * n_cols, 4 * n_rows))\n",
    "    axs = axs.flatten()\n",
    "\n",
    "    for e, ax in enumerate(axs):\n",
    "        first_corners = X[e, :2, :]\n",
    "        model.eval()\n",
    "        next_corners = (\n",
    "            model(X[e : e + 1, :2].to(device)).squeeze().detach().cpu().numpy()\n",
    "        )\n",
    "        pred_corners = np.concatenate([first_corners, next_corners], axis=0)\n",
    "\n",
    "        for j, corners in enumerate([X[e], pred_corners]):\n",
    "            for i in range(4):\n",
    "                coords = corners[i]\n",
    "                color = \"k\"\n",
    "                ax.scatter(*coords, c=color, s=400)\n",
    "                if i == 3:\n",
    "                    start = -1\n",
    "                else:\n",
    "                    start = i\n",
    "                if (not j) or (j and i):\n",
    "                    ax.plot(\n",
    "                        *corners[[start, start + 1]].T,\n",
    "                        c=\"k\",\n",
    "                        lw=2,\n",
    "                        alpha=0.5,\n",
    "                        linestyle=\"--\" if j else \"-\",\n",
    "                    )\n",
    "                ax.text(\n",
    "                    *(coords - np.array([0.04, 0.04])), str(i + 1), c=\"w\", fontsize=12\n",
    "                )\n",
    "                if directions is not None:\n",
    "                    ax.set_title(f\"{'Counter-' if not directions[e] else ''}Clockwise\")\n",
    "\n",
    "        ax.set_xlabel(r\"$x_0$\")\n",
    "        ax.set_ylabel(r\"$x_1$\", rotation=0)\n",
    "        ax.set_xlim([-1.45, 1.45])\n",
    "        ax.set_ylim([-1.45, 1.45])\n",
    "\n",
    "    fig.tight_layout()\n",
    "    return fig\n"
   ]
  },
