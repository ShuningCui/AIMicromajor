    "def generate_sequences(n=128, variable_len=False, seed=13):\n",
    "    \"\"\"随机生成 n 组沿着正方形轮廓游走的坐标序列，每条序列随机选择起点、\n",
    "    正向 / 反向绕行；可选固定长度或随机长度，叠加微小噪声；\n",
    "    标签就是绕行方向，用来做序列分类训练。\"\"\"\n",
    "\n",
    "    basic_corners = np.array([[-1, -1], [-1, 1], [1, 1], [1, -1]])\n",
    "    # 创建独立随机数生成器\n",
    "    rng = np.random.default_rng(seed)\n",
    "    bases = rng.integers(4, size=n)\n",
    "    if variable_len:\n",
    "        # 3个可选值：0,1,2 → +2 → 2,3,4\n",
    "        lengths = rng.integers(3, size=n) + 2\n",
    "    else:\n",
    "        lengths = [4] * n\n",
    "\n",
    "    directions = rng.integers(2, size=n)\n",
    "\n",
    "    points = [\n",
    "        basic_corners[[(b + i) % 4 for i in range(4)]][slice(None, None, d * 2 - 1)][:l]\n",
    "        + rng.standard_normal((l, 2)) * 0.1\n",
    "        for b, d, l in zip(bases, directions, lengths)\n",
    "    ]\n",
    "    return np.array(points), np.array(directions)\n"
   ]
  },
